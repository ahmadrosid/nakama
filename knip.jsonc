{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // First-run baseline: teach the graph, then ignore leftovers instead of deleting unused code.
  "workspaces": {
    "apps/server": {
      "entry": ["src/index.ts", "scripts/*.ts"]
    },
    "apps/web": {
      "entry": ["src/shims/*.ts"]
    },
    // Not in package.json#workspaces; Knip would skip it otherwise.
    "docs/website": {}
  },
  // Leftover unused deps: root listings used by workspaces, Biome via Ultracite, unused jose/croner.
  "ignoreDependencies": [
    "croner",
    "bcryptjs",
    "hugeicons-react",
    "jose",
    "@biomejs/biome",
    "@types/bcryptjs"
  ],
  // Type-only import Knip cannot resolve.
  "ignoreUnresolved": ["../../services/auth-service"],
  // Leftover unused exports/types/duplicates on the current tree. New files still fail.
  "ignoreIssues": {
    "apps/cli/src/profile.ts": ["exports"],
    "apps/cli/src/styled-text.ts": ["exports", "types"],
    "apps/platform/automation/src/config.ts": ["exports"],
    "apps/platform/telegram/src/test-helpers.ts": ["exports", "types"],
