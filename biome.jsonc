{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // bun fmt formats (.oxfmtrc.json) and bun lint runs the rules turned off in
  // overrides below (.oxlintrc.json). Biome keeps the rules bun lint has no
  // equivalent for, CSS, and import and JSX attribute order. The map is each
  // rule's ESLint source in Biome's rules-sources table.
  "formatter": { "enabled": false },
  "json": { "formatter": { "enabled": false } },
  "html": { "formatter": { "enabled": false } },
  "graphql": { "formatter": { "enabled": false } },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "a11y": {
            "noAccessKey": "off",
            "noAriaHiddenOnFocusable": "off",
            "noAriaUnsupportedElements": "off",
            "noDistractingElements": "off",
            "noHeaderScope": "off",
            "noInteractiveElementToNoninteractiveRole": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "noNoninteractiveTabindex": "off",
            "noPositiveTabindex": "off",
            "noRedundantAlt": "off",
            "noRedundantRoles": "off",
            "useAltText": "off",
            "useAnchorContent": "off",
            "useAriaActivedescendantWithTabindex": "off",
            "useButtonType": "off",
            "useHtmlLang": "off",
            "useIframeTitle": "off",
            "useKeyWithMouseEvents": "off",
            "useValidAnchor": "off",
            "useValidAriaProps": "off",
            "useValidAriaRole": "off",
            "useValidAriaValues": "off",
            "useValidAutocomplete": "off",
            "useValidLang": "off"
          },
          "complexity": {
            "noAdjacentSpacesInRegex": "off",
            "noArguments": "off",
            "noCommaOperator": "off",
            "noDivRegex": "off",
            "noExcessiveNestedCallbacks": "off",
            "noExcessiveNestedTestSuites": "off",
            "noExtraBooleanCast": "off",
            "noFlatMapIdentity": "off",
            "noStaticOnlyClass": "off",
            "noUselessCatch": "off",
            "noUselessCatchBinding": "off",
            "noUselessConstructor": "off",
            "noUselessEmptyExport": "off",
            "noUselessEscapeInRegex": "off",
            "noUselessLabel": "off",
            "noUselessLoneBlockStatements": "off",
            "noUselessRename": "off",
            "noUselessStringConcat": "off",
            "noUselessSwitchCase": "off",
            "noUselessTernary": "off",
            "noUselessTypeConstraint": "off",
            "noUselessUndefinedInitialization": "off",
            "useArraySome": "off",
            "useDateNow": "off",
            "useFlatMap": "off",
            "useIndexOf": "off",
            "useNumericLiterals": "off",
            "useRegexLiterals": "off"
          },
          "correctness": {
            "noChildrenProp": "off",
            "noConstAssign": "off",
            "noConstantCondition": "off",
            "noConstantMathMinMaxClamp": "off",
            "noConstructorReturn": "off",
            "noDuplicateArgumentNames": "off",
            "noEmptyCharacterClassInRegex": "off",
            "noEmptyPattern": "off",
            "noGlobalDirnameFilename": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noJsxNamespace": "off",
            "noNonoctalDecimalEscape": "off",
            "noPrecisionLoss": "off",
            "noRenderReturnValue": "off",
            "noSelfAssign": "off",
            "noSetterReturn": "off",
            "noSwitchDeclarations": "off",
            "noUnknownProperty": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off",
            "noUnsafeFinally": "off",
            "noUnsafeOptionalChaining": "off",
            "noUnusedLabels": "off",
            "noUnusedPrivateClassMembers": "off",
            "noVoidElementsWithChildren": "off",
            "useIsNan": "off",
            "useJsxKeyInIterable": "off",
            "useParseIntRadix": "off",
            "useValidForDirection": "off",
            "useValidTypeof": "off",
            "useYield": "off"
          },
          "performance": {
            "noAccumulatingSpread": "off",
            "noSyncScripts": "off",
            "noUnwantedPolyfillio": "off",
            "useDomNodeTextContent": "off",
            "useGoogleFontPreconnect": "off"
          },
          "security": {
            "noBlankTarget": "off",
            "noDangerouslySetInnerHtmlWithChildren": "off",
            "noGlobalEval": "off"
          },
          "style": {
            "noDoneCallback": "off",
            "noInferrableTypes": "off",
            "noMultilineString": "off",
            "noNamespace": "off",
            "noNegationElse": "off",
            "noRestrictedGlobals": "off",
            "noRestrictedImports": "off",
            "noRestrictedTypes": "off",
            "noSubstr": "off",
            "noUselessElse": "off",
            "noYodaExpression": "off",
            "useArrayLiterals": "off",
            "useAsConstAssertion": "off",
            "useBlockStatements": "off",
            "useCollapsedElseIf": "off",
            "useCollapsedIf": "off",
            "useConsistentObjectDefinitions": "off",
            "useEnumInitializers": "off",
            "useExponentiationOperator": "off",
            "useExportType": "off",
            "useForOf": "off",
            "useFragmentSyntax": "off",
            "useGroupedAccessorPairs": "off",
            "useLiteralEnumMembers": "off",
            "useNodejsImportProtocol": "off",
            "useNumberNamespace": "off",
            "useObjectSpread": "off",
            "useReduceTypeParameter": "off",
            "useShorthandAssign": "off",
            "useShorthandFunctionType": "off",
            "useSpreadOverApply": "off",
            "useSymbolDescription": "off",
            "useThrowNewError": "off",
            "useThrowOnlyError": "off",
            "useTrimStartEnd": "off",
            "useUnifiedTypeSignatures": "off"
          },
          "suspicious": {
            "noAlert": "off",
            "noApproximativeNumericConstant": "off",
            "noAssignInExpressions": "off",
            "noAsyncPromiseExecutor": "off",
            "noCatchAssign": "off",
            "noClassAssign": "off",
            "noCommentText": "off",
            "noCompareNegZero": "off",
            "noConfusingLabels": "off",
            "noConstantBinaryExpressions": "off",
            "noDebugger": "off",
            "noDocumentCookie": "off",
            "noDuplicateCase": "off",
            "noDuplicateClassMembers": "off",
            "noDuplicateElseIf": "off",
            "noDuplicateEnumValues": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noDuplicateTestHooks": "off",
            "noExportsInTest": "off",
            "noExtraNonNullAssertion": "off",
            "noFocusedTests": "off",
            "noForIn": "off",
            "noFunctionAssign": "off",
            "noGlobalAssign": "off",
            "noGlobalIsFinite": "off",
            "noGlobalIsNan": "off",
            "noImportAssign": "off",
            "noIrregularWhitespace": "off",
            "noLabelVar": "off",
            "noMisleadingCharacterClass": "off",
            "noMisleadingInstantiator": "off",
            "noMisrefactoredShorthandAssign": "off",
            "noNestedPromises": "off",
            "noNonNullAssertedOptionalChain": "off",
            "noOctalEscape": "off",
            "noParametersOnlyUsedInRecursion": "off",
            "noProto": "off",
            "noPrototypeBuiltins": "off",
            "noReactStringRefs": "off",
            "noRedeclare": "off",
            "noRedundantUseStrict": "off",
            "noReturnAssign": "off",
            "noShadowRestrictedNames": "off",
            "noSkippedTests": "off",
            "noSparseArray": "off",
            "noThenProperty": "off",
            "noTsIgnore": "off",
            "noUnsafeDeclarationMerging": "off",
            "noUnsafeNegation": "off",
            "noUnusedExpressions": "off",
            "noUselessEscapeInString": "off",
            "noUselessRegexBackrefs": "off",
            "noWith": "off",
            "useAdjacentOverloadSignatures": "off",
            "useDefaultSwitchClauseLast": "off",
            "useErrorMessage": "off",
            "useGoogleFontDisplay": "off",
            "useGuardForIn": "off",
            "useIsArray": "off",
            "useIterableCallbackReturn": "off",
            "useNamespaceKeyword": "off",
            "useNumberToFixedDigitsArgument": "off"
          }
        }
      }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!packages/plugins/*/actions",
      "!packages/plugins/*/ui/app.js",
      "!packages/plugins/*/workers",
      "!tools/oxlint/anti-slop",
      "!apps/web/src/components/moodstone/core",
      "!apps/web/src/components/moodstone/svg.ts"
    ]
  },
  "css": {
    "formatter": { "enabled": false },
    "parser": {
      "cssModules": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedProperties": "off"
      }
    }
  },
  "javascript": {
    "formatter": { "enabled": false },
    "globals": ["Bun"]
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      // Existing monorepo: keep Ultracite formatting + correctness, defer
      // high-churn style/perf rules until files are touched intentionally.
      "a11y": {
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsForRole": "off",
        "useAriaPropsSupportedByRole": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "useMathMinMax": "off",
        "useRegexpTest": "off",
        "useWhile": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noVoid": "off",
        "useArrayFind": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noComponentHookFactories": "off",
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "off",
        "noUnusedInstantiation": "off",
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useImageSize": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noDelete": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "security": {
        "useIframeSandbox": "off",
        "noDangerouslySetInnerHtml": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "style": {
        "noExcessiveClassesPerFile": "off",
        "useConsistentTestIt": "off",
        "useDomQuerySelector": "off",
        "useImportsFirst": "off",
        "useNamedCaptureGroup": "off",
        "useTestHooksOnTop": "off",
        "useThisInClassMethods": "off",
        "useUnicodeRegex": "off",
        "useVarsOnTop": "off",
        "noExportedImports": "off",
        "noIncrementDecrement": "off",
        "noMultiAssign": "off",
        "noDescendingSpecificity": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noParameterProperties": "off",
        "useAtIndex": "off",
        "useConsistentArrayType": "off",
        "useConsistentBuiltinInstantiation": "off",
        "useConsistentMemberAccessibility": "off",
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": "off",
        "useDefaultParameterLast": "off",
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useReadonlyClassProperties": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noConditionalExpect": "off",
        "noDuplicateSelectors": "off",
        "noIdenticalTestTitle": "off",
        "noImportCycles": "off",
        "noLoopFunc": "off",
        "useBaseline": "off",
        "useExpect": "off",
        "noAlert": "error",
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "noDuplicateJsxProps": "off",
        "noEmptyBlockStatements": "off",
        "noEqualsToNull": "off",
        "noEvolvingTypes": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noLeakedRender": "off",
        "noMisplacedAssertion": "off",
        "noReactForwardRef": "off",
        "noSelfCompare": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "noVar": "off",
        "useArraySortCompare": "off",
        "useAwait": "off",
        "useGetterReturn": "off",
        "useStaticResponseMethods": "off"
      }
    }
  }
}
