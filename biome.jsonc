{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      // Existing monorepo: keep Ultracite formatting + correctness, defer
      // high-churn style/perf rules until files are touched intentionally.
      "a11y": {
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsForRole": "off",
        "useAriaPropsSupportedByRole": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noVoid": "off",
        "useArrayFind": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "off",
        "noUnusedInstantiation": "off",
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useImageSize": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noDelete": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noExportedImports": "off",
        "noIncrementDecrement": "off",
        "noMultiAssign": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noParameterProperties": "off",
        "useAtIndex": "off",
        "useConsistentArrayType": "off",
        "useConsistentBuiltinInstantiation": "off",
        "useConsistentMemberAccessibility": "off",
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": "off",
        "useDefaultParameterLast": "off",
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useReadonlyClassProperties": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAlert": "off",
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "noDuplicateJsxProps": "off",
        "noEmptyBlockStatements": "off",
        "noEqualsToNull": "off",
        "noEvolvingTypes": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noLeakedRender": "off",
        "noMisplacedAssertion": "off",
        "noReactForwardRef": "off",
        "noSelfCompare": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "noVar": "off",
        "useArraySortCompare": "off",
        "useAwait": "off",
        "useGetterReturn": "off",
        "useStaticResponseMethods": "off"
      }
    }
  }
}
