{
  "name": "nakama-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate-mirrors && next build",
    "check:pipeline": "bun run scripts/check-docs-pipeline.ts",
    "dev": "bun run generate-mirrors && next dev -p 3004",
    "generate-mirrors": "bun run scripts/postbuild.ts",
    "preview": "serve out -p 3004 -c serve.json",
    "screenshots": "./scripts/capture-setup-screenshots.sh",
    "screenshots:chat": "./scripts/capture-chat-screenshots.sh",
    "screenshots:error-tracking": "./scripts/capture-error-tracking-screenshots.sh",
    "screenshots:mcp": "./scripts/capture-mcp-screenshots.sh",
    "screenshots:self-improving-skills": "./scripts/capture-self-improving-skills-screenshots.sh",
    "screenshots:telegram": "./scripts/capture-telegram-screenshots.sh"
  },
  "overrides": {
    "compression": "1.8.2"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.5.3",
    "fumadocs-ui": "^16.18.4",
    "hugeicons-react": "^0.4.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0"
  }
}
