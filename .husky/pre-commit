# ultracite
#!/bin/sh
# Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# Block files over 5,000 tokens
bun run scripts/check-file-size.ts || exit 1

# Run formatter, capturing the exit code so we can still re-stage and report
FORMAT_EXIT_CODE=0
bun x ultracite fix --staged || FORMAT_EXIT_CODE=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Ultracite"
# ultracite end

# React Doctor: only when staged changes touch React code. Any warning blocks,
# so the score stays at 100.
REACT_FILES=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '\.(tsx|jsx)$|^(apps/web|packages/ui|packages/plugins)/.*\.(ts|js)$' || true)
if [ -n "$REACT_FILES" ]; then
  bun x react-doctor --staged -y --no-supply-chain --blocking warning \
    --project @nakama/web,@nakama/ui,@nakama/plugin-supermemory || exit 1
fi
