{
  "name": "nakama",
  "version": "0.4.61",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/platform/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "build:docs": "bun run --cwd docs/website build",
    "check": "ultracite check && bun run check:anti-slop",
    "check:acp": "bun run scripts/check-acp.ts",
    "check:anti-slop": "oxlint",
    "check:ci": "oxlint && oxlint apps/server/src/http --ignore-pattern 'apps/server/src/http/routes/**' && oxlint docs/website && ultracite check docs/website",
    "cli": "bun run apps/cli/src/index.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "dev": "bun run dev:web",
    "dev:automation": "bun run --filter @nakama/automation dev",
    "dev:discord": "bun run --filter @nakama/discord dev",
    "dev:docs": "bun run --cwd docs/website dev",
    "dev:server": "bun run apps/server/src/dev.ts",
    "dev:slack": "bun run --filter @nakama/slack dev",
    "dev:teams": "bun run --filter @nakama/teams dev",
    "dev:telegram": "bun run --filter @nakama/telegram dev",
    "dev:web": "bun run --filter @nakama/web dev",
    "dev:whatsapp": "bun run --filter @nakama/whatsapp dev",
    "docs:install": "bun install --cwd docs/website --frozen-lockfile --ignore-scripts",
    "doctor": "bun x react-doctor",
    "dupes": "bun x jscpd --format typescript,tsx .",
    "fix": "ultracite fix && oxlint --fix",
    "postinstall": "bun run docs:install",
    "knip": "knip",
    "prepare": "husky",
    "preview:docs": "bun run --cwd docs/website preview",
    "start": "bun run apps/server/dist/index.js",
    "test": "bun test --path-ignore-patterns '**/apps/web/**' && bun run --cwd apps/web test --parallel=4",
    "view:cassettes": "bun run apps/server/src/testing/cassettes/serve.ts"
  },
  "overrides": {
    "@peculiar/asn1-schema": "2.9.5",
    "libsignal": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "jscpd": "4.3.0",
    "knip": "6.38.0",
    "oxlint": "1.89.0",
    "react-doctor": "0.9.18",
    "ultracite": "7.11.0"
  },
  "patchedDependencies": {
    "@electron/osx-sign@1.3.3": "patches/@electron%2Fosx-sign@1.3.3.patch",
    "pm2@7.0.4": "patches/pm2@7.0.4.patch"
  }
}
