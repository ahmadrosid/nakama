{
  "name": "nakama",
  "version": "0.4.76",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/platform/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "build:docs": "bun run --cwd docs/website build",
    "check": "bun scripts/check-types.ts",
    "check:acp": "bun run scripts/check-acp.ts",
    "check:ci": "sh -c 's=0; bun lint || s=1; bun fmt --check || s=1; biome check || s=1; bun check || s=1; exit $s'",
    "cli": "bun run apps/cli/src/index.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "dev": "bun run dev:web",
    "dev:automation": "bun run --filter @nakama/automation dev",
    "dev:discord": "bun run --filter @nakama/discord dev",
    "dev:docs": "bun run --cwd docs/website dev",
    "dev:server": "bun run apps/server/src/dev.ts",
    "dev:slack": "bun run --filter @nakama/slack dev",
    "dev:teams": "bun run --filter @nakama/teams dev",
    "dev:telegram": "bun run --filter @nakama/telegram dev",
    "dev:web": "bun run --filter @nakama/web dev",
    "dev:whatsapp": "bun run --filter @nakama/whatsapp dev",
    "docs:install": "bun install --cwd docs/website --frozen-lockfile --ignore-scripts",
    "doctor": "bun x react-doctor",
    "dupes": "bun x jscpd --format typescript,tsx .",
    "fix": "bun lint --fix && bun fmt && biome check --write",
    "fmt": "bun scripts/bun-canary.ts fmt",
    "postinstall": "bun run docs:install",
    "knip": "knip",
    "lint": "bun scripts/bun-canary.ts lint",
    "prepare": "sh -c 'command -v hk >/dev/null || { echo \"Install hk 2.13 for the git hooks: brew install hk (or mise use hk@2.13.0), then run: bun run prepare\" >&2; exit 1; }; git config --unset core.hooksPath; hk install'",
    "preview:docs": "bun run --cwd docs/website preview",
    "start": "bun run apps/server/dist/index.js",
    "test": "bun test --parallel=4 --path-ignore-patterns '**/apps/web/**' && bun run --cwd apps/web test --parallel=4",
    "view:cassettes": "bun run apps/server/src/testing/cassettes/serve.ts"
  },
  "overrides": {
    "@peculiar/asn1-schema": "2.9.5",
    "js-yaml": "4.3.2",
    "libsignal": "6.0.0",
    "nodemailer": "10.1.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@oven/bun-darwin-aarch64": "1.4.5-canary.20261120.1",
    "@oven/bun-darwin-x64": "1.4.5-canary.20261120.1",
    "@oven/bun-linux-aarch64": "1.4.5-canary.20261120.1",
    "@oven/bun-linux-x64": "1.4.5-canary.20261120.1",
    "@oven/bun-windows-x64": "1.4.5-canary.20261120.1",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.4.4",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "react-doctor": "0.9.18",
    "ultracite": "8.2.1"
  },
  "patchedDependencies": {
    "@electron/osx-sign@1.3.3": "patches/@electron%2Fosx-sign@1.3.3.patch",
    "pm2@7.1.2": "patches/pm2@7.1.2.patch"
  }
}
