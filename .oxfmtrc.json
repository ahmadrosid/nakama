{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": false,
  "printWidth": 80,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    ".worktrees/**",
    ".local-poc/**",
    ".tmp-test-config/**",
    ".jscpd-report/**",
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "outputs/**",
    "tools/oxlint/anti-slop/**",
    "apps/web/src/components/moodstone/core/**",
    "apps/web/src/components/moodstone/svg.ts",
    "packages/plugins/*/actions/**",
    "packages/plugins/*/ui/app.js",
    "packages/plugins/*/workers/**",
    "**/*.html",
    "**/*.md",
    "**/*.mdx"
  ],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.json5"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "sortPackageJson": false
}
