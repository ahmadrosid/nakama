{
  "apiVersion": 1,
  "id": "data-view",
  "name": "Data View",
  "version": "0.1.0",
  "minNakamaVersion": "0.4.10",
  "author": "Nakama",
  "license": "MIT",
  "description": "Keep a local copy of a Google Sheet to view and edit for free, then sync your edits back.",
  "actions": [
    {
      "key": "add_sheet",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": true,
      "description": "Save a Google Sheets link in Data View and fetch its data once. Later reads use the saved copy, so they cost nothing.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["url"]
      }
    },
    {
      "key": "list_sheets",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": true,
      "description": "List sheets saved in Data View with their size and unsynced edit count.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "key": "read_sheet",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": true,
      "description": "Read rows from a saved sheet copy. Rows use sheet row numbers; row 1 is the header. Pass query to keep rows that contain the text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "query": {
            "type": "string"
          }
        },
        "required": ["sheetId"]
      }
    },
    {
      "key": "update_cells",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": true,
      "description": "Edit cells in the saved sheet copy only; Google Sheets does not change until a person presses Sync. row is the sheet row number (1 is the header, one past the last row adds a row). column is a header name or a column letter such as B.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["row", "column", "value"]
            }
          }
        },
        "required": ["sheetId", "edits"]
      }
    },
    {
      "key": "get_sheet",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Get sheet",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sheetId"]
      }
    },
    {
      "key": "refresh_sheet",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Refresh sheet",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          },
          "discardEdits": {
            "type": "boolean"
          }
        },
        "required": ["sheetId"]
      }
    },
    {
      "key": "sync_sheet",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Sync sheet",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sheetId"]
      }
    },
    {
      "key": "delete_sheet",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Delete sheet",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sheetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sheetId"]
      }
    }
  ],
  "skills": [
    {
      "key": "data-view",
      "directory": "skills/data-view"
    }
  ],
  "database": {
    "migrations": [
      {
        "id": "001-data-view",
        "path": "migrations/001-data-view.sql"
      }
    ]
  },
  "ui": {
    "entryModule": "ui/app.js",
    "assetsDir": "ui",
    "pageLabel": "Data View"
  }
}
