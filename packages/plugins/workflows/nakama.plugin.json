    },
    {
      "key": "tools",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Tools",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agentId": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "key": "import_legacy",
      "access": "admin",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Import legacy",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "access": "member",
      "description": "database",
      "effect": "read",
      "entry": "actions/actions.js",
      "key": "database",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "access": "member",
      "description": "get run",
      "effect": "read",
      "entry": "actions/actions.js",
      "key": "get_run",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflowId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        },
        "required": ["workflowId", "runId"]
      }
    }
  ],
  "skills": [
    {
      "key": "create-workflow",
      "directory": "skills/create-workflow"
    }
  ],
  "database": {
    "migrations": [
