{
  "manifest_version": 3,
  "name": "Nakama Google Meet Transcriber",
  "version": "0.1.0",
  "description": "Capture Google Meet audio for a Nakama live transcript.",
  "minimum_chrome_version": "116",
  "icons": { "192": "icon.png" },
  "permissions": [
    "activeTab",
    "alarms",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": ["https://meet.google.com/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Nakama Meet transcription"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
