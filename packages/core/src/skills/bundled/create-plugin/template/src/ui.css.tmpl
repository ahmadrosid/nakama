/* Scope every rule to this plugin. Colors come from the host variables, so the
   page matches Nakama in light and dark mode. Size tokens use the --n- prefix. */
[data-plugin-id="__PLUGIN_ID__"] {
  --n-space-1: 4px;
  --n-space-2: 8px;
  --n-space-3: 12px;
  --n-space-4: 16px;
  --n-space-6: 24px;
  --n-text-xs: 12px;
  --n-text-sm: 13px;
  --n-text-base: 14px;
  --n-text-lg: 18px;
  --n-weight-medium: 500;
  --n-weight-semibold: 600;
  --n-radius: var(--radius);
  --n-radius-sm: calc(var(--radius) - 4px);
  --n-font-mono: "JetBrains Mono Variable", ui-monospace, monospace;
  --n-content-width: 720px;
  /* Good numbers and gains. Use --destructive for bad ones. */
  --n-positive: oklch(50.8% 0.118 165.612);

  .plugin-page {
    display: flex;
    flex-direction: column;
    gap: var(--n-space-4);
    max-width: var(--n-content-width);
    color: var(--foreground);
    font-size: var(--n-text-base);
    line-height: 1.5;
    container-type: inline-size;
  }

  /* Pages built around a Table. */
  .plugin-page-wide {
    max-width: 960px;
  }

  .plugin-dialog-form {
    display: flex;
    flex-direction: column;
    gap: var(--n-space-4);
  }

  .plugin-loading {
    display: flex;
    align-items: center;
    gap: var(--n-space-2);
  }

  /* A destructive button on the left of a DialogFooter. */
  .plugin-footer-start {
    margin-inline-end: auto;
  }

  /* Table cells. Names and short text stay on one line. */
  .plugin-strong {
    font-weight: var(--n-weight-medium);
    white-space: nowrap;
  }

  .plugin-nowrap {
    white-space: nowrap;
  }

  .plugin-secondary {
    color: var(--muted-foreground);
  }

  .plugin-number {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* The name in each row is a link Button that opens the edit dialog. */
  .plugin-row-link {
    height: auto;
    padding: 0;
    color: var(--foreground);
    font-weight: var(--n-weight-medium);
  }

  /* The chat side panel is about 360px wide: drop the least useful columns. */
  @container (max-width: 520px) {
    .plugin-optional {
      display: none;
    }
  }

  /* ctx.ui Card ships a shadow; plugin pages use borders only. */
  [data-slot="card"] {
    box-shadow: none;
  }

  /* Content inside a Card. The Card draws the border and background. */
  .plugin-panel {
    display: flex;
    flex-direction: column;
    gap: var(--n-space-3);
  }

  .plugin-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--n-space-2);
  }

  .plugin-form > input {
    flex: 1 1 200px;
    width: auto;
  }

  .plugin-result {
    margin: 0;
    padding: var(--n-space-3);
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--n-radius);
    background: var(--muted);
    font-family: var(--n-font-mono);
    font-size: var(--n-text-xs);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .plugin-error {
    margin: 0;
    color: var(--destructive);
    font-size: var(--n-text-sm);
  }

  .plugin-muted {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--n-text-sm);
  }
}

.dark [data-plugin-id="__PLUGIN_ID__"] {
  --n-positive: oklch(84.5% 0.143 164.978);
}
